# Observatoire Économique Espace Sabaudo — variables d'environnement
# Copier ce fichier en `.env` et renseigner les valeurs réelles.
# Le fichier `.env` est ignoré par git (voir .gitignore).

# Clé API Anthropic (https://console.anthropic.com/)
ANTHROPIC_API_KEY=

# Chemin du fichier d'identifiants OAuth2 Gmail/Drive (téléchargé depuis Google Cloud Console)
GMAIL_CREDENTIALS_PATH=config/credentials.json

# Identifiant du dossier Google Drive « Observatoire Économique »
DRIVE_FOLDER_ID=1OWmS4oC7rw2BGQtInnuM2_8kE0wkXv53

# Sous-dossiers Drive où déposer les résultats (créés automatiquement au besoin)
DRIVE_VEILLE_BRUTE_SUBFOLDER=01_Veille_brute
DRIVE_VEILLE_TRAITEE_SUBFOLDER=02_Veille_traitee

# --- Brevo (brouillon de newsletter automatique — AUCUN envoi auto) ---
# Clé API : Brevo > Paramètres > SMTP & API > Clés API
BREVO_API_KEY=
# Nom affiché de l'expéditeur
BREVO_SENDER_NAME=Cultura Sabauda
# Email expéditeur — DOIT être un expéditeur validé dans Brevo
BREVO_SENDER_EMAIL=
# Id(s) de la liste de destinataires (un seul : 3 — ou plusieurs : 3,4)
# Pour trouver l'id : python scripts/push_brevo.py --check
BREVO_LIST_ID=
# --- Personnalisation : ciblage par SEGMENT (recommandé) ou par LISTE (repli) ---
# Pour chaque édition, le SEGMENT est prioritaire sur la LISTE de même portée.
# Les segments rangent les contacts AUTOMATIQUEMENT selon LANGUE/TERRITOIRE
# (aucun tri manuel) ; ids visibles via : python scripts/brevo_setup.py --check
#
# Segment par langue :
# (IDs actuels dans Brevo — à reporter tels quels dans le .env du VPS)
BREVO_SEGMENT_ID_FR=7
BREVO_SEGMENT_ID_IT=8
# Segment par territoire d'ancrage (édition « Chez vous » en tête, une locale).
# Suffixes : SAVOIE, PIEMONTE, VALLEE_AOSTE, NICE.
BREVO_SEGMENT_ID_FR_NICE=9
BREVO_SEGMENT_ID_FR_SAVOIE=10
BREVO_SEGMENT_ID_IT_PIEMONTE=11
# BREVO_SEGMENT_ID_FR_VALLEE_AOSTE=  (à créer quand le lectorat valdôtain existe)
#
# Repli par LISTES (si tu n'utilises pas les segments) :
BREVO_LIST_ID_FR=
BREVO_LIST_ID_IT=
# BREVO_LIST_ID_FR_NICE=
# BREVO_LIST_ID_FR_SAVOIE=
# BREVO_LIST_ID_IT_PIEMONTE=
# (Option) Logos Cultura Sabauda hébergés (bibliothèque média Brevo) :
#   BREVO_LOGO_URL  : logo HORIZONTAL → en-tête (masthead)
#   BREVO_PICTO_URL : pictogramme     → pied de page
# Si vide : la newsletter s'affiche sans ces visuels (les favicons des sources restent).
BREVO_LOGO_URL=
BREVO_PICTO_URL=

# --- Optionnels (valeurs par défaut entre parenthèses) ---
# Modèle Anthropic pour la synthèse (claude-sonnet-4-6)
# ANTHROPIC_MODEL=claude-sonnet-4-6
# La une commence TOUJOURS par un article avec une vraie photo : on cherche la
# photo de l'acteur par recherche web (1 = activé, défaut ; 0 pour désactiver).
# AUTO_PHOTO=1
# Nombre maximum de recherches de photo testées pour trouver une une illustrée.
# AUTO_PHOTO_MAX=5
# Lien « Lire l'article » trouvé automatiquement pour les sujets issus de la presse :
# Nos Alpes (partenaire) d'abord, sinon une source primaire/officielle (1 = activé).
# AUTO_SOURCE=1
# Nombre maximum de recherches de lien par édition (borne le coût/la durée et le débit).
# AUTO_SOURCE_MAX=6
# Intervalle minimal (s) entre deux recherches web — lisse le débit (évite les 429).
# L'augmenter si le compte a une limite de tokens/min basse. WEB_SEARCH_INTERVAL=5
# Pause (s) après la grosse synthèse, avant les recherches web (laisse la fenêtre
# tokens/min se vider). L'augmenter si les 1ers liens partent encore en 429. WEB_SEARCH_COOLDOWN=30
# Fenêtre de collecte Gmail en jours pour le cron hebdomadaire (8)
# GMAIL_LOOKBACK_DAYS=8
# Délai max (secondes) pour la collecte d'un flux RSS (30)
# RSS_TIMEOUT=30
